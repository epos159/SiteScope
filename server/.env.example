PORT=3001
# Full origin with https:// (bare hostname breaks browser CORS)
CLIENT_ORIGIN=https://sitescope.poschventures.com

# Stripe test secret (sk_test_...). Live key replaces this when you go live.
STRIPE_SECRET_KEY=
# Signing secret from the webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Test price for the $30/month SiteScope plan. Live mode has a different price id.
STRIPE_PRICE_ID=price_1USmqUPwFnfB0QLEGNT28qKu
# Set to true after Stripe Tax is activated and the Pennsylvania license is in place.
STRIPE_AUTOMATIC_TAX=false
# Comma-separated emails that skip the paywall (your own login).
COMPED_EMAILS=
# Firebase service account JSON, one line. Project settings → Service accounts → Generate new private key.
FIREBASE_SERVICE_ACCOUNT=
